# =============================================================================
# PRIEST MD — Developed by Inkora Systems
# Environment configuration template.
#
# 1. Copy this file to `.env`:            cp .env.example .env
# 2. Fill in your values. NEVER commit `.env` (it is git-ignored).
# 3. Restart the bot:                     npm start
#
# All variables below are OPTIONAL unless marked (required).
# =============================================================================

# ---- Bot identity -----------------------------------------------------------
# Public name of your bot (used in menus, messages, DB records).
BOT_NAME=Priest MD

# Owner display name (used in owner commands / branding).
OWNER_NAME=Inkora

# Command prefix(es), comma separated. First one is the default.
BOT_PREFIX=.,

# ---- WhatsApp owners & admins ----------------------------------------------
# Bare WhatsApp numbers (country code + number, NO +, spaces or dashes) that
# own the bot. These get full owner privileges (owner-only commands, control).
# Used by: config/config.js -> config.owner -> super-user resolution.
OWNERS=233241234567,491512345678

# ---- WhatsApp session -------------------------------------------------------
# SESSION_ID (optional): import an existing WhatsApp credential blob.
# Accepts base64 of a Baileys `creds.json`, optionally gzipped, optionally
# prefixed with "PriestMD~". Used ONLY when a session number has no
# credentials on disk yet (sessions/<number>/creds.json).
# Get a fresh one by pairing a device via QR / pairing code instead.
SESSION_ID=

# WhatsApp runtime toggles (optional; defaults come from configuration.json).
WHATSAPP_AUTO_RECONNECT=true
WHATSAPP_PAIRING_CODE=true
WHATSAPP_RECONNECT_DELAY_MS=5000
WHATSAPP_MAX_RECONNECT_RETRIES=10

# Bot icon shown on WhatsApp when a session connects (path relative to project
# root). Replace assets/bot-icon.png with your own image (square, JPG/PNG).
WHATSAPP_BOT_ICON=assets/bot-icon.png

# "Connect music" — audio sent when a session comes online (path relative to
# project root). Currently ships with assets/music/connect.mp3 (30s preview of
# "Elevate" — DJ Khalil, Spider-Verse soundtrack). Replace with any MP3/OGG/M4A.
# target: self (bot's own chat) or owner (first number in OWNERS).
WHATSAPP_CONNECT_MUSIC=assets/music/connect.mp3
WHATSAPP_CONNECT_MUSIC_TARGET=self

# ---- MongoDB (database) -----------------------------------------------------
# Connection string for your MongoDB instance. The bot still boots without
# MongoDB (in-memory degraded mode), but commands/persistence need it.
MONGODB_URI=mongodb://127.0.0.1:27017/priestmd

# ---- Telegram control panel -------------------------------------------------
# Bot token from @BotFather. WITHOUT it the Telegram control panel is disabled
# (WhatsApp itself keeps working). Required for /pair, /sessions, dashboard.
TELEGRAM_TOKEN=

# Telegram user IDs / usernames allowed to control the bot (comma separated).
TELEGRAM_ADMINS=123456789,@your_username

# ---- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ---- Optional: third-party API keys -----------------------------------------
# JSON object consumed by optional command modules (downloaders, search, etc.).
# API_KEYS={"example":"abc123"}

# Gifted API key used by black-hat AI/downloader commands (.gemini, .chatai,
# .fb, .tiktok, ...). Falls back to the public default key if unset; get your
# own at https://api.gifted.co.ke to avoid shared rate limits.
GIFTED_API_KEY=
